# Скопируйте в /etc/hotelbot.env (права 600) и заполните.
# Не коммитьте заполненный файл и не отправляйте его содержимое в чат.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram id: бот принимает команды только от него
OWNER_TELEGRAM_ID=
# Ключ Anthropic API
ANTHROPIC_API_KEY=

# Почтовый ящик, с которого пишем отелям (IMAP + SMTP, пароль приложения).
# Пример для Gmail (нужна двухэтапная аутентификация и пароль приложения):
MAIL_ADDRESS=ваш-адрес@gmail.com
# Логин для входа; у Gmail это полный адрес (можно не задавать). У Яндекса: часть адреса до @
MAIL_USER=
# Пароль приложения (не основной пароль от аккаунта)
MAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
# 465 = SSL, любой другой порт (например 587) = STARTTLS
SMTP_PORT=465
# Для Яндекса: IMAP_HOST=imap.yandex.ru, SMTP_HOST=smtp.yandex.ru
# Имя отправителя в письмах (необязательно)
MAIL_FROM_NAME=

# Где лежат данные (переписка, факты, вопросы)
HOTELBOT_DATA_DIR=/var/lib/hotelbot/data

# 1 = письма НЕ отправляются, только записываются в переписку (режим проверки).
# Поставьте 0, когда убедитесь, что всё работает.
DRY_RUN=1

# Необязательные настройки
MODEL=claude-sonnet-5-5
OWNER_TZ=Asia/Yekaterinburg
POLL_INTERVAL_SECONDS=120
MAX_EMAILS_PER_HOUR=15
MAX_EMAILS_PER_DAY=60
MAX_AGENT_ITERATIONS=25
